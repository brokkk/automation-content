# Supabase Configuration (Server uses service role key for full access)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# OpenRouter API Key (free models available!)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# LLM Model
LLM_MODEL=deepseek/deepseek-v3.2

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173

# Instagram Graph API
# Long-lived token (60 days) - auto-refreshed by server
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# Facebook App credentials (for Instagram token auto-refresh)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
